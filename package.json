{
  "name": "reels-while-thinking",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local OpenCode task watcher with a React control dashboard",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
